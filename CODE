<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover"/>
  <title>LIV.U · Dark</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Fraunces:ital,opsz,wght@0,9..144,200;0,9..144,300;0,9..144,400;1,9..144,200;1,9..144,300;1,9..144,400&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%;overflow:hidden;background:#06091A !important;color-scheme:dark;}
    :root{background:#06091A;
      --cream:#06091A;
      --card:#0A0F1C;
      --ink:#F0EDE8;
      --ink-60:rgba(240,237,232,0.60);
      --ink-35:rgba(240,237,232,0.35);
      --ink-15:rgba(240,237,232,0.15);
      --ink-08:rgba(240,237,232,0.08);
      --ink-04:rgba(240,237,232,0.04);
      --green:#00E676;
      --blue:#2979FF;
      --pink:#D500F9;
      --serif:'Fraunces',Georgia,serif;
      --sans:'Inter',-apple-system,sans-serif;
      --ease:cubic-bezier(0.16,1,0.3,1);
    }
    body{background:#06091A;color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;}

    /* ── STATE HAIRLINE ── */
    #state-line{
      position:fixed;top:0;left:0;right:0;height:2px;
      background:var(--green);z-index:500;
      opacity:0;transition:opacity .8s ease,background 2.2s ease;
    }
    #state-line.visible{opacity:1;}

    /* ── KEYFRAMES ── */
    @keyframes fade-rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    @keyframes orb-breathe{
      0%{transform:scale(1)}
      42%{transform:scale(1.042)} /* 4.2s */
      100%{transform:scale(1)}    /* 5.8s out */
    }
    @keyframes orb-pulse{0%{opacity:.35;transform:scale(1)}100%{opacity:0;transform:scale(1.45)}}
    @keyframes score-surface{from{opacity:.15;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
    @keyframes pulse-line{0%,100%{opacity:0;transform:scaleY(.6)}50%{opacity:.55;transform:scaleY(1)}}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes gene-pop{from{opacity:0;transform:translateX(-3px)}to{opacity:1;transform:translateX(0)}}
    @keyframes account-flash{0%{opacity:0}15%{opacity:1}85%{opacity:1}100%{opacity:0}}
    @keyframes sheet-rise{from{transform:translateY(100%)}to{transform:translateY(0)}}
    @keyframes path-draw{from{stroke-dashoffset:400}to{stroke-dashoffset:0}}

    /* ════════════════════════════════════
       SCREEN 1 — THE MARK
    ════════════════════════════════════ */
    #s1{
      position:fixed;inset:0;z-index:100;
      background:#06091A;
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      transition:opacity .7s var(--ease);
    }
    #s1.exit{opacity:0;pointer-events:none;}
    #s1-img{
      display:none;
    }
    #s1-crest{
      position:absolute;
      top:50%;left:50%;
      transform:translate(-50%,-50%);
      display:flex;align-items:center;justify-content:center;
      transition:transform .9s cubic-bezier(0.16,1,0.3,1);
    }
    #s1.revealed #s1-crest{
      transform:translate(-50%,-60%);
    }
    #s1-logo-img{
      width:220px;height:auto;
      /* Transparent PNG — no filter needed */
    }
    #s1-bottom{
      position:absolute;
      bottom:0;left:0;right:0;
      padding:24px 32px 52px;
      background:#06091A;
      transform:translateY(100%);
      opacity:0;
      transition:transform .8s cubic-bezier(0.16,1,0.3,1),opacity .7s ease;
    }
    #s1-bottom.revealed{
      transform:translateY(0);
      opacity:1;
    }
    #s1-quote{
      font-family:var(--serif);font-size:26px;font-weight:200;
      font-style:italic;line-height:1.3;letter-spacing:-.025em;
      color:rgba(240,237,232,0.88);margin-bottom:24px;
    }
    #s1-quote .accent{font-style:normal;color:var(--green);font-weight:300;}
    #s1-actions{display:flex;flex-direction:column;gap:8px;}
    .s1-btn{
      width:100%;padding:14px;border-radius:12px;
      border:1px solid var(--ink-15);
      background:rgba(255,255,255,0.06);
      color:rgba(240,237,232,0.88);font-family:var(--sans);font-size:11px;font-weight:500;
      letter-spacing:.18em;text-transform:uppercase;cursor:pointer;
      display:flex;align-items:center;justify-content:center;
      -webkit-tap-highlight-color:transparent;text-decoration:none;
    }
    .s1-btn.ghost{
      background:transparent;border:none;
      color:var(--ink-60);font-size:10px;font-weight:300;letter-spacing:.14em;
    }

    /* ════════════════════════════════════
       MAIN APP — CREAM SCROLL
    ════════════════════════════════════ */
    #app{
      position:fixed;inset:0;z-index:50;
      overflow-y:auto;-webkit-overflow-scrolling:touch;
      scrollbar-width:none;
      background:#06091A;
      opacity:0;pointer-events:none;
      transition:opacity .8s var(--ease);
    }
    #app::-webkit-scrollbar{display:none;}
    #app.visible{opacity:1;pointer-events:auto;}

    /* ── APP HEADER ── */
    #app-header{
      position:sticky;top:0;z-index:200;
      display:flex;align-items:center;justify-content:space-between;
      padding:13px 22px 11px;
      background:rgba(6,9,26,.95);
      backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
      border-bottom:none;
    }
    #app-icon-mark{
      color:rgba(240,237,232,0.60);
      display:flex;align-items:center;
    }
    #header-settings-btn{
      width:32px;height:32px;border-radius:50%;background:none;border:none;
      cursor:pointer;display:flex;align-items:center;justify-content:center;
      color:rgba(240,237,232,0.35);-webkit-tap-highlight-color:transparent;
    }

    /* ── ORB HERO ── */
    #orb-hero{
      min-height:100vh;
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      position:relative;
      background:var(--cream);
    }
    /* Orb ambient glow — blooms on cream */
    #orb-ambient{
      position:absolute;width:320px;height:320px;border-radius:50%;
      background:radial-gradient(circle,rgba(0,230,118,.07) 0%,transparent 70%);
      transition:background 2.2s ease;
      pointer-events:none;
    }
    .orb-scene{
      position:relative;display:flex;align-items:center;justify-content:center;
      width:260px;height:260px;
    }
    .orb-ring{position:absolute;border-radius:50%;border:1px solid;}
    .orb-ring-1{width:260px;height:260px;border-color:var(--ink-04);}
    .orb-ring-2{width:200px;height:200px;border-color:var(--ink-04);}
    .orb-glow{
      position:absolute;width:170px;height:170px;border-radius:50%;
      background:radial-gradient(circle,rgba(0,230,118,.18) 0%,rgba(0,230,118,.06) 50%,transparent 75%);
      transition:background 2.2s ease;filter:blur(6px);
    }
    .orb-pulse-ring{
      position:absolute;width:170px;height:170px;border-radius:50%;
      border:1px solid rgba(0,230,118,.22);
      animation:orb-pulse 4s ease-out infinite;
    }
    .orb-core{
      position:relative;z-index:2;
      width:150px;height:150px;border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      cursor:pointer;-webkit-tap-highlight-color:transparent;user-select:none;
      animation:orb-breathe 10s ease-in-out infinite;
    }
    #orb-word{
      font-family:var(--serif);font-size:22px;font-weight:200;
      font-style:italic;letter-spacing:-.02em;color:var(--green);
      transition:opacity .5s ease,color 1.8s ease;
    }
    #orb-score{
      font-family:var(--serif);font-size:80px;font-weight:200;
      letter-spacing:-.06em;line-height:1;display:none;
      font-feature-settings:'tnum';color:var(--green);
    }
    #orb-time{
      position:absolute;bottom:72px;
      font-family:var(--sans);font-size:10px;font-weight:300;
      letter-spacing:.10em;color:var(--ink-35);
      opacity:0;transition:opacity 1s ease;
    }
    /* Scroll affordance */
    #scroll-afford{
      position:absolute;bottom:32px;left:50%;transform:translateX(-50%);
      width:1px;height:36px;opacity:0;
      background:linear-gradient(to bottom,transparent,rgba(0,230,118,.45),transparent);
    }



    /* ── CREAM SCROLL CARDS ── */
    #scroll-cards{
      max-width:420px;margin:0 auto;
      padding:0 28px 120px;
      background:#06091A;
    }
    .scroll-section-label{
      font-family:var(--sans);font-size:9px;font-weight:500;
      letter-spacing:.28em;text-transform:uppercase;color:var(--ink-35);
      margin:28px 0 14px;display:block;
      background:#06091A;
    }
    .scroll-section-label::after{display:none;}

    /* BORDERLESS CARDS — separated by whitespace */
    .rec-card{
      padding:24px 0;
      cursor:pointer;
      position:relative;
      border-bottom:1px solid var(--ink-04);
      -webkit-tap-highlight-color:transparent;
    }
    .rec-card.urgent{padding-top:52px;}/* +28px urgency whitespace */
    .rec-card:last-child{border-bottom:none;}
    .rec-card-header{
      display:flex;align-items:flex-start;justify-content:space-between;gap:12px;
    }
    .rec-card-left{flex:1;}
    .rec-urgency-dot{
      width:5px;height:5px;border-radius:50%;
      display:inline-block;margin-right:8px;
      vertical-align:middle;margin-bottom:2px;
    }
    .rec-title{
      font-family:var(--serif);font-size:18px;font-weight:300;
      font-style:italic;letter-spacing:-.015em;color:var(--ink);
      line-height:1.35;margin-bottom:4px;
    }
    .rec-card.urgent .rec-title{font-size:20px;}
    .rec-meta{
      font-family:var(--sans);font-size:11px;font-weight:300;
      color:var(--ink-35);display:flex;align-items:center;gap:10px;
    }
    .rec-tag{
      font-family:var(--sans);font-size:9px;font-weight:500;
      letter-spacing:.14em;text-transform:uppercase;
    }
    .rec-expand-icon{
      width:22px;height:22px;border-radius:50%;
      border:1px solid var(--ink-08);
      display:flex;align-items:center;justify-content:center;
      flex-shrink:0;margin-top:2px;
      transition:transform .3s var(--ease),border-color .2s;
      color:var(--ink-35);
    }
    .rec-card.open .rec-expand-icon{
      transform:rotate(45deg);border-color:var(--ink-15);
    }

    /* Inline insight — 3-line Fraunces discipline */
    .rec-insight{
      max-height:0;overflow:hidden;
      transition:max-height .4s var(--ease),margin-top .4s var(--ease);
      margin-top:0;
    }
    .rec-card.open .rec-insight{
      max-height:120px;
      margin-top:14px;
    }
    .rec-insight-text{
      font-family:var(--serif);font-size:16px;font-weight:300;
      font-style:italic;line-height:1.65;letter-spacing:-.01em;
      color:var(--ink-60);
      display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;
      overflow:hidden;
    }
    .rec-deepdive{
      margin-top:12px;
      font-family:var(--sans);font-size:10px;font-weight:500;
      letter-spacing:.18em;text-transform:uppercase;color:var(--ink-35);
      display:flex;align-items:center;gap:6px;cursor:pointer;
      -webkit-tap-highlight-color:transparent;
      border:none;background:none;padding:0;
    }

    /* ── SIGNAL CARDS (alternating typography) ── */
    .signal-card{
      background:rgba(255,255,255,0.04);
      border:none;
      border-radius:18px;padding:24px;margin-bottom:10px;
    }
    .signal-eyebrow{
      font-family:var(--sans);font-size:9px;font-weight:600;
      letter-spacing:.24em;text-transform:uppercase;color:var(--ink-60);
      margin-bottom:16px;
    }
    /* Alt sentence rhythm */
    .alt{line-height:1.65;margin-bottom:10px;}
    .alt:last-child{margin-bottom:0;}
    .alt-sf{
      font-family:var(--serif);font-size:17px;font-weight:300;
      letter-spacing:-.015em;color:var(--ink);
    }
    .alt-sn{
      font-family:var(--sans);font-size:13px;font-weight:300;
      color:var(--ink-60);letter-spacing:.01em;
    }
    .alt-rule{display:none;}

    /* live countdown */
    .live-c{
      font-family:var(--serif);font-size:15px;font-weight:300;
      font-style:italic;color:var(--green);letter-spacing:-.01em;
    }

    /* ── END-OF-DAY ── */
    .eod{
      text-align:center;padding:40px 0 20px;
    }
    .eod p{
      font-family:var(--serif);font-size:24px;font-weight:200;
      font-style:italic;line-height:1.4;letter-spacing:-.025em;
      color:var(--ink-35);
    }
    .eod em{font-style:normal;color:var(--green);font-weight:300;}

    /* ════════════════════════════════════
       PANELS (slide up)
    ════════════════════════════════════ */
    .panel{
      position:fixed;inset:0;z-index:800;
      background:var(--cream);
      transform:translateY(100%);
      transition:transform .55s var(--ease);
      overflow-y:auto;pointer-events:none;
      -webkit-overflow-scrolling:touch;
      scrollbar-width:none;
    }
    .panel::-webkit-scrollbar{display:none;}
    .panel.open{transform:translateY(0);pointer-events:auto;}
    .panel-nav{
      position:sticky;top:0;z-index:10;
      display:flex;align-items:center;justify-content:space-between;
      padding:16px 28px;
      background:rgba(6,9,26,.96);
      backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);
      border-bottom:1px solid var(--ink-08);
    }
    .panel-logo{
      font-family:var(--sans);font-size:11px;font-weight:500;
      letter-spacing:.32em;text-transform:uppercase;color:var(--ink);
    }
    .panel-btn{
      display:inline-flex;align-items:center;gap:6px;
      border:1px solid var(--ink-15);border-radius:999px;
      padding:7px 14px 7px 10px;background:none;
      font-family:var(--sans);font-size:10px;font-weight:500;
      letter-spacing:.16em;text-transform:uppercase;color:var(--ink-35);
      cursor:pointer;-webkit-tap-highlight-color:transparent;
    }

    /* ════════════════════════════════════
       ONBOARDING PANEL
    ════════════════════════════════════ */
    .ob-body{max-width:420px;margin:0 auto;padding:0 28px 80px;}
    .ob-step{display:none;}
    .ob-step.active{display:block;animation:fade-rise .45s var(--ease) both;}
    #account-ready{
      position:fixed;bottom:28px;left:50%;transform:translateX(-50%);
      background:rgba(0,230,118,.10);border:1px solid rgba(0,230,118,.22);
      border-radius:999px;padding:8px 18px;
      font-family:var(--sans);font-size:10px;font-weight:500;
      letter-spacing:.16em;text-transform:uppercase;color:var(--green);
      pointer-events:none;opacity:0;z-index:9999;white-space:nowrap;
      animation:account-flash 2.4s ease .8s both;
    }
    .q-intro{
      padding:40px 0 28px;
      font-family:var(--serif);font-size:26px;font-weight:200;
      font-style:italic;line-height:1.35;letter-spacing:-.02em;color:var(--ink);
    }
    .q-opts{display:flex;flex-direction:column;gap:8px;}
    .q-opt{
      width:100%;padding:17px 20px;border-radius:14px;
      border:1px solid var(--ink-08);background:var(--card);
      cursor:pointer;display:flex;align-items:center;gap:13px;
      text-align:left;-webkit-tap-highlight-color:transparent;
      transition:border-color .2s,background .2s,transform .1s;
    }
    .q-opt:active{transform:scale(.99);}
    .q-opt.sel{border-color:rgba(0,230,118,.32);background:rgba(0,230,118,.04);}
    .q-dot{
      width:7px;height:7px;border-radius:50%;background:var(--ink-15);flex-shrink:0;
      transition:background .2s;
    }
    .q-opt.sel .q-dot{background:var(--green);box-shadow:0 0 7px rgba(0,230,118,.5);}
    .q-title{font-family:var(--sans);font-size:14px;font-weight:400;color:var(--ink);margin-bottom:2px;}
    .q-sub{font-family:var(--sans);font-size:11px;font-weight:300;color:var(--ink-35);}
    /* Profile result */
    .profile-card{
      background:var(--card);border:1px solid var(--ink-08);
      border-radius:18px;padding:22px;margin-bottom:10px;
    }
    .profile-row{
      display:flex;align-items:center;gap:9px;padding:9px 0;
      border-bottom:1px solid var(--ink-04);
      font-family:var(--sans);font-size:13px;font-weight:300;color:var(--ink-60);
    }
    .profile-row:last-child{border-bottom:none;}
    .profile-dot{width:5px;height:5px;border-radius:50%;background:var(--green);flex-shrink:0;}
    .ob-cta{
      width:100%;padding:15px;border-radius:12px;
      border:1px solid var(--ink-15);background:var(--cream);
      color:var(--ink);font-family:var(--sans);font-size:12px;font-weight:500;
      letter-spacing:.16em;text-transform:uppercase;cursor:pointer;
      margin-top:18px;display:flex;align-items:center;justify-content:center;
      -webkit-tap-highlight-color:transparent;
      opacity:0;pointer-events:none;
      transition:opacity .5s ease,border-color .2s;
    }
    .ob-cta.show{opacity:1;pointer-events:auto;}

    /* ════════════════════════════════════
       CONNECT PANEL
    ════════════════════════════════════ */
    .conn-body{max-width:420px;margin:0 auto;padding:0 28px 80px;}
    .conn-sl{
      font-family:var(--sans);font-size:9px;font-weight:500;
      letter-spacing:.28em;text-transform:uppercase;color:var(--ink-35);
      margin:32px 0 12px;display:flex;align-items:center;gap:10px;
    }
    .conn-sl::after{content:"";flex:1;height:1px;background:var(--ink-08);}
    .conn-card{
      background:var(--card);border:1px solid var(--ink-08);
      border-radius:16px;padding:18px;margin-bottom:10px;
    }
    /* Horizon timeline */
    .horizon-wrap{overflow-x:auto;scrollbar-width:none;margin:0 -4px;}
    .horizon-wrap::-webkit-scrollbar{display:none;}
    .horizon-track{display:flex;align-items:stretch;min-width:max-content;padding:0 4px;gap:3px;}
    .h-seg{
      height:48px;border-radius:8px;display:flex;align-items:center;
      justify-content:center;padding:0 10px;
      font-family:var(--sans);font-size:9px;font-weight:500;
      letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;
      position:relative;
    }
    /* Time cursor */
    .h-cursor{
      position:absolute;top:0;bottom:0;width:1px;
      background:var(--green);opacity:.7;
      left:var(--cursor-left,50%);
      pointer-events:none;
    }
    /* Recovery gap */
    .h-gap{
      width:32px;border-radius:8px;
      border:1px solid rgba(0,230,118,.20);
      background:rgba(0,230,118,.03);
      height:48px;
    }
    /* Gene sequence */
    .gene-seq{display:flex;flex-wrap:wrap;gap:5px;min-height:24px;margin-top:8px;}
    .gene-mk{
      font-family:var(--sans);font-size:10px;font-weight:400;
      letter-spacing:.06em;color:var(--green);opacity:0;
    }
    .gene-mk.show{animation:gene-pop .3s var(--ease) both;}
    .conn-prov-btn{
      padding:12px;border-radius:11px;
      font-family:var(--sans);font-size:11px;font-weight:500;
      letter-spacing:.14em;text-transform:uppercase;cursor:pointer;
      border:1px solid rgba(0,230,118,.25);
      background:rgba(0,230,118,.04);color:#007A3A;
      transition:background .15s;
    }
    .conn-prov-btn.blue{
      border-color:rgba(41,121,255,.25);
      background:rgba(41,121,255,.04);color:#1a5ccc;
    }
    .conn-see-score{
      width:100%;padding:15px;border-radius:12px;
      border:1px solid var(--ink-15);background:var(--cream);
      color:var(--ink);font-family:var(--sans);font-size:12px;font-weight:500;
      letter-spacing:.16em;text-transform:uppercase;cursor:pointer;
      margin-top:28px;display:flex;align-items:center;justify-content:center;gap:9px;
      -webkit-tap-highlight-color:transparent;
    }

    /* ════════════════════════════════════
       DEEP-DIVE SHEET (92% bottom sheet)
    ════════════════════════════════════ */
    #deepdive-sheet{
      position:fixed;inset:0;z-index:900;
      pointer-events:none;
    }
    #deepdive-sheet.open{pointer-events:auto;}
    #deepdive-bg{
      position:absolute;inset:0;
      background:rgba(0,0,0,.45);
      opacity:0;transition:opacity .4s ease;
    }
    #deepdive-sheet.open #deepdive-bg{opacity:1;}
    #deepdive-inner{
      position:absolute;bottom:0;left:0;right:0;
      height:92%;border-radius:20px 20px 0 0;
      background:var(--card);
      transform:translateY(100%);
      transition:transform .55s var(--ease);
      overflow-y:auto;-webkit-overflow-scrolling:touch;
      scrollbar-width:none;
    }
    #deepdive-inner::-webkit-scrollbar{display:none;}
    #deepdive-sheet.open #deepdive-inner{transform:translateY(0);}
    #deepdive-peek{
      position:absolute;top:0;left:0;right:0;height:8%;
      display:flex;align-items:flex-end;justify-content:center;
      padding-bottom:8px;cursor:pointer;
    }
    .sheet-pill{
      width:36px;height:4px;border-radius:2px;background:var(--ink-15);
    }
    .sheet-header{
      padding:24px 28px 16px;
