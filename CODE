function buildHorizon(){
  // 18-hour window: 5AM–11PM
  // Segments: 5AM free, 8AM school, gap, 12PM free, gap, 3PM training, gap, 7PM match, 9PM free, 11PM
  var now=new Date();var nowH=now.getHours()+now.getMinutes()/60;
  var segments=[
    {label:'5AM',w:40,bg:'var(--ink-04)',color:'var(--ink-35)'},
    {label:'School',w:90,bg:'rgba(41,121,255,.07)',color:'var(--blue)'},
    {label:'gap'},
    {label:'',w:50,bg:'var(--ink-04)',color:'var(--ink-35)'},
    {label:'gap'},
    {label:'Training',w:80,bg:'rgba(0,230,118,.07)',color:'var(--green)'},
    {label:'gap'},
    {label:'Match',w:90,bg:'rgba(213,0,249,.06)',color:'var(--pink)'},
    {label:'',w:50,bg:'var(--ink-04)',color:'var(--ink-35)'},
  ];
  var track=document.getElementById('horizon-track');
  track.innerHTML='';
  segments.forEach(function(s){
    if(s.label==='gap'){
      var g=document.createElement('div');g.className='h-gap';track.appendChild(g);
    } else {
      var d=document.createElement('div');
      d.className='h-seg';
      d.style.cssText='width:'+s.w+'px;background:'+s.bg+';color:'+s.color+';';
      d.textContent=s.label;
      track.appendChild(d);
    }
  });
  // Time cursor
  var cursorEl=document.createElement('div');
  cursorEl.className='h-cursor';
  cursorEl.style.left='45%';
  track.appendChild(cursorEl);
}

