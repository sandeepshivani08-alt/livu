function goToApp(){
  try{localStorage.setItem('livu_onboarded','true');}catch(e){}
  // Fade out s1
  var s1=document.getElementById('s1');
  s1.classList.add('exit');
  // Reveal app
  var app=document.getElementById('app');
  app.classList.add('visible');
  // Show state hairline
  setTimeout(function(){
    document.getElementById('state-line').classList.add('visible');
  },400);
  // Scroll observer
  app.addEventListener('scroll',onScroll,{passive:true});
  // Start orb
  setTimeout(startOrbRotation,600);
  h(12);
}

// ════════════════════════════════════════
// ORB
// ════════════════════════════════════════
function setOrbState(state){
  var s=STATES[state]; orbCur=state;
  var w=document.getElementById('orb-word');
  var g=document.getElementById('orb-glow');
  var amb=document.getElementById('orb-ambient');
  var pr=document.getElementById('orb-pulse');
  var sl=document.getElementById('state-line');
  if(w){w.style.color=s.color;w.textContent=s.word;}
  if(g){g.style.background='radial-gradient(circle,'+s.glow+' 0%,transparent 72%)';}
  if(amb){amb.style.background='radial-gradient(circle,'+s.ambient+' 0%,transparent 70%)';}
  if(pr){pr.style.borderColor=s.pulse;}
  if(sl){sl.style.background=s.color;}
  document.documentElement.style.setProperty('--cur-state',s.color);
}

function startOrbRotation(){
  if(orbTimer)return;
  setOrbState(CYCLE[0]);
  function next(){
    orbPhase++;
    if(orbPhase>=CYCLE.length){
      clearTimeout(orbTimer);orbTimer=null;
      // Settle: word fades, score surfaces
      setTimeout(function(){
        var w=document.getElementById('orb-word');
        var sc=document.getElementById('orb-score');
              var s=STATES[orbCur];
        if(w){w.style.transition='opacity 1s ease';w.style.opacity='0';}
        setTimeout(function(){
          if(w)w.style.display='none';
          if(sc){
            sc.style.display='block';sc.style.opacity='0';
            sc.style.color=s.color;sc.textContent=s.num;
            sc.style.animation='score-surface 2.4s cubic-bezier(0.16,1,0.3,1) both';
            orbNum=true;
          }
          // Timestamp
          setTimeout(function(){document.getElementById('orb-time').style.opacity='1';},1500);
          // Scroll affordance — one pulse at 3s
          setTimeout(function(){
            var sa=document.getElementById('scroll-afford');
            if(sa){sa.style.animation='pulse-line 1.8s ease both';sa.style.opacity='1';
              setTimeout(function(){sa.style.opacity='0';},2000);}
          },3000);
        },1000);
      },400);
      return;
    }
    setOrbState(CYCLE[orbPhase%CYCLE.length]);
    orbTimer=setTimeout(next,2400);
  }
  orbTimer=setTimeout(next,2200);
}

function orbToggle(e){
  e.stopPropagation();h(12);
  if(orbTimer){clearTimeout(orbTimer);orbTimer=null;}
  var w=document.getElementById('orb-word'),sc=document.getElementById('orb-score'),s=STATES[orbCur];
  orbNum=!orbNum;
  if(orbNum){
    if(w){w.style.transition='opacity .3s';w.style.opacity='0';setTimeout(function(){w.style.display='none';},300);}
    setTimeout(function(){if(sc){sc.style.display='block';sc.style.color=s.color;sc.textContent=s.num;sc.style.animation='score-surface .8s ease both';}},250);
  } else {
    if(sc){sc.style.animation='none';sc.style.opacity='0';setTimeout(function(){sc.style.display='none';},250);}
    setTimeout(function(){if(w){w.style.display='block';w.style.opacity='0';w.style.color=s.color;w.textContent=s.word;setTimeout(function(){w.style.transition='opacity .4s';w.style.opacity='1';},20);}},250);
  }
}

// ════════════════════════════════════════
// SCROLL — sticky header + hairline fade
// ════════════════════════════════════════
function onScroll(){
  var app=document.getElementById('app');
  var sl=document.getElementById('state-line');
  var scrolled=app.scrollTop;
  // Hairline fades toward end of scroll
  var maxScroll=app.scrollHeight-app.clientHeight;
  if(maxScroll>0&&sl){
    var progress=scrolled/maxScroll;
    var opacity=1-progress*0.75;
    sl.style.opacity=opacity;
  }
}

// ════════════════════════════════════════
// INLINE CARD EXPANSION
// ════════════════════════════════════════
function toggleCard(e,cardId,type){
  var card=document.getElementById(cardId);
  var isOpen=card.classList.contains('open');
  // Anchor scroll position to prevent jump
  var app=document.getElementById('app');
  var cardTop=card.getBoundingClientRect().top;
  var scrollBefore=app.scrollTop;
  card.classList.toggle('open');
  // Re-anchor if card is above viewport center
  if(!isOpen){
    requestAnimationFrame(function(){
      var delta=card.getBoundingClientRect().top-cardTop;
      if(delta!==0)app.scrollTop=scrollBefore+delta;
    });
  }
  h(6);
}

// ════════════════════════════════════════
// DEEP-DIVE SHEET
// ════════════════════════════════════════
function openDeepDive(key){
  h(10);
  var dd=DEEP_DIVES[key];
  if(!dd)return;
  document.getElementById('sheet-origin').textContent=dd.origin||'';
  document.getElementById('sheet-title').textContent=dd.title||'';
  var body=document.getElementById('sheet-body');
  var html='';
  // Graph card
  if(dd.graph){
    var pts=dd.graph.points;
    var max=Math.max.apply(null,pts);
    var min=Math.min.apply(null,pts);
    var range=max-min||1;
    var w=320,h2=70;
    var step=w/(pts.length-1);
    var pathD=pts.map(function(v,i){
      var x=i*step;
      var y=h2-((v-min)/range)*(h2-4)-2;
      return (i===0?'M':'L')+x.toFixed(1)+','+y.toFixed(1);
    }).join(' ');
    html+='<div class="graph-card"><div class="graph-label">'+dd.title+'</div><div class="graph-area"><div class="graph-axis"></div><svg class="graph-svg" viewBox="0 0 '+w+' '+h2+'" preserveAspectRatio="none"><path class="graph-path" d="'+pathD+'" style="stroke:'+dd.graph.color+';"/></svg></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-family:var(--sans);font-size:9px;font-weight:300;color:var(--ink-35);"><span>30 days ago</span><span>Today · '+pts[pts.length-1]+'ms</span></div></div>';
  }
  // Genomic card
  if(dd.genomic){
    var gn=dd.genomic;
    html+='<div class="sheet-genomic"><div class="genomic-gene" style="color:'+gn.color+'">'+gn.gene+'</div><div class="genomic-body">'+gn.title+'</div><div style="height:1px;background:var(--ink-08);margin-bottom:12px;"></div><div class="genomic-detail">'+gn.body+'</div></div>';
    html+='<div class="sheet-genomic" style="background:none;border:none;padding:0;"><div class="genomic-detail" style="font-size:10px;color:var(--ink-35);line-height:1.7;border-top:1px solid var(--ink-08);padding-top:12px;">'+gn.detail+'</div></div>';
  }
  body.innerHTML=html;
  var sheet=document.getElementById('deepdive-sheet');
  sheet.classList.add('open');
}
function closeDeepDive(){
  h(6);
  document.getElementById('deepdive-sheet').classList.remove('open');
}
// Swipe to dismiss sheet
var sheetStartY=null;
var inner=document.getElementById('deepdive-inner');
inner.addEventListener('touchstart',function(e){sheetStartY=e.touches[0].clientY;},{passive:true});
inner.addEventListener('touchend',function(e){
  if(sheetStartY===null)return;
  var dy=e.changedTouches[0].clientY-sheetStartY;
  sheetStartY=null;
  if(dy>60&&inner.scrollTop<=0)closeDeepDive();
},{passive:true});

