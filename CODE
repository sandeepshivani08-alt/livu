var obStep=1;
function obQ(qNum,btn,answer,adj){
  h(6);
  var step=document.getElementById('ob-q'+qNum);
  step.querySelectorAll('.q-opt').forEach(function(b){b.classList.remove('sel');});
  btn.classList.add('sel');
  answers['q'+qNum]=answer;
  if(adj)answers.adj=adj;

  var labels=['Question 1 of 4','Question 2 of 4','Question 3 of 4','Question 4 of 4','Your profile'];
  var nextStep=qNum<4?'ob-q'+(qNum+1):'ob-result';
  document.getElementById('ob-nav-label').textContent=labels[qNum];

  setTimeout(function(){
    step.classList.remove('active');
    document.getElementById(nextStep).classList.add('active');
    if(nextStep==='ob-result')buildProfile();
  },300);
}
function buildProfile(){
  var sport=answers.q1||'Soccer';
  var p=PROFILES[sport]||PROFILES.Soccer;
  document.getElementById('result-title').textContent=sport;
  document.getElementById('result-sub').textContent=p.sub;
  var adj=answers.adj||p.adj;
  document.getElementById('profile-adjs').innerHTML=adj.map(function(a){
    return '<div class="profile-row"><div class="profile-dot"></div>'+a+'</div>';
  }).join('');
  // CTA appears after 2s — let athlete read their profile
  setTimeout(function(){
    document.getElementById('ob-cta').classList.add('show');
  },2000);
}

